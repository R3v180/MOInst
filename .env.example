# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require&channel_binding=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-strong-random-secret-for-production"
NEXTAUTH_URL="http://localhost:3000"

# Uploads directory (local storage for attachments)
UPLOAD_DIR="./upload"

# Gemini / Google AI — rotación automática si una clave devuelve 429 (orden: izquierda → derecha)
NEXT_PUBLIC_GEMINI_API_KEYS="TU_API_KEY_1,TU_API_KEY_2,TU_API_KEY_3,TU_API_KEY_4"
GOOGLE_API_KEY="TU_API_KEY_1"
GOOGLE_API_KEYS="TU_API_KEY_1,TU_API_KEY_2,TU_API_KEY_3,TU_API_KEY_4"
